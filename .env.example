# انسخي هذا الملف إلى .env وضعي مفتاحك. لا ترفعي .env إلى git أبداً.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# أسماء النماذج (تحقق منها في وثائق Anthropic)
MAIN_MODEL=claude-sonnet-5-5
WITNESS_A_MODEL=claude-sonnet-5-5
WITNESS_B_MODEL=claude-haiku-4-5

LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
# جهد التفكير (low|medium|high). يُتجاهل تلقائياً للنماذج التي لا تدعمه مثل Haiku 4.5
LLM_EFFORT=medium
# cache الاستجابات (on|off). يُعطَّل فقط لقياس الثبات في eval/run_eval.py
LLM_CACHE=on

# قاعدة البيانات (التقارير + cache + سجل الاستدعاءات)
DATABASE_PATH=data/runtime/miraah.db
# ردود الأمثلة الجاهزة من data/seed/llm_cache.jsonl تُحمَّل في الـcache عند التشغيل (on|off)
SEED_CACHE=on

# حد الطلبات التي تستدعي النموذج لكل IP في الساعة (0 = بلا حد). الأمثلة الجاهزة لا تُحتسب
RATE_LIMIT_PER_HOUR=30

PORT=8000
