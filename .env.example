# انسخي هذا الملف إلى .env وضعي مفتاحك. لا ترفعي .env إلى git أبداً.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# أسماء النماذج (تحقق منها في وثائق Anthropic)
MAIN_MODEL=claude-sonnet-5-5
WITNESS_A_MODEL=claude-sonnet-5-5
WITNESS_B_MODEL=claude-haiku-4-5

LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120

# قاعدة البيانات (التقارير + cache + سجل الاستدعاءات)
DATABASE_PATH=data/runtime/miraah.db

PORT=8000
